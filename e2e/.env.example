# Salin berkas ini menjadi .env (berkas .env sendiri sengaja tidak ikut
# disimpan di Git — lihat .gitignore) lalu isi nilai sesuai lingkungan lokal
# masing-masing sebelum menjalankan `npx playwright test`.

# Alamat halaman-halaman yang diuji, mengikuti server lokal `php artisan serve`.
LOGIN_API_KEY=http://127.0.0.1:8000/login
BARANG_API_KEY=http://127.0.0.1:8000/barang
TRANSAKSI_API_KEY=http://127.0.0.1:8000/transaksi
LAPORAN_LABA_API_KEY=http://127.0.0.1:8000/laporan/laba-rugi
LAPORAN_PENJUALAN_API_KEY=http://127.0.0.1:8000/laporan/penjualan

# Kredensial akun yang dipakai untuk login selama pengujian e2e.
# JANGAN menuliskan kredensial sungguhan langsung di berkas .spec.ts.
E2E_EMAIL=ratih@gmail.com
E2E_PASSWORD=ratih123
